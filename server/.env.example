NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Atlas - Replace with your MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/tenthouse

# JWT Secret - Change this to a random string in production
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Cloudinary - Add your Cloudinary credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

ADMIN_NAME=Your Name
ADMIN_EMAIL=your-email@example.com
ADMIN_PHONE=9876543210
ADMIN_PASSWORD=a_strong_password_at_least_12_characters

EMAIL_FROM=bookings@yourdomain.com

# Razorpay (for future integration)
RAZORPAY_KEY_ID=your_razorpay_key
RAZORPAY_KEY_SECRET=your_razorpay_secret




